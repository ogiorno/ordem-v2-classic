{
  "name": "foundry-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "sync": "node scripts/sync-systems.mjs",
    "render-check": "node scripts/render-check.mjs && node scripts/render-check-grimoire.mjs",
    "lang-check": "node scripts/lang-check.mjs",
    "link": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/link.ps1",
    "packs:pack": "node scripts/packs.mjs pack",
    "packs:check": "node scripts/check-packs.mjs",
    "packs:unpack": "node scripts/packs.mjs unpack",
    "test": "node --test \"systems/ordem-v2-classic/tests/unit/**/*.test.mjs\"",
    "test:livro": "node --test \"systems/ordem-v2-classic/tests/livro/**/*.livro.mjs\"",
    "lint": "eslint modules systems"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "eslint": "^9.0.0",
    "handlebars": "^4.7.9"
  }
}
