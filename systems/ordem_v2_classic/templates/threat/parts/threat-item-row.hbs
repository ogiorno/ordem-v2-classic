<li class="item sb-item sb-item-{{item.rowKind}}" data-document-class="Item" data-item-id="{{item._id}}">
	<div class="sb-item-main">
		<div class="sb-item-text">
			<a class="sb-item-name" data-action="toggleDescription">{{item.name}}</a>
			{{#if item.rowMeta}}<span class="sb-item-meta">{{item.rowMeta}}</span>{{/if}}
			{{#if item.testLabel}}<span class="sb-pill sb-pill-test">{{localize "op.test"}} {{item.testLabel}}</span>{{/if}}
			{{#if item.damageLabel}}<span class="sb-pill sb-pill-dmg">{{localize "op.damage"}} {{item.damageLabel}}</span>{{/if}}
		</div>
		<div class="sb-item-ctl">
			{{#if @root.editable}}
				<a class="sb-icon" data-action="{{item.editAction}}" data-tooltip="{{localize 'op.threat.edit'}}"><i class="fas fa-edit"></i></a>
				<a class="sb-icon" data-action="deleteDoc" data-tooltip="{{localize 'op.threat.remove'}}"><i class="fas fa-trash"></i></a>
			{{/if}}
			<a class="sb-die" data-action="onRoll" data-roll-type="item" data-tooltip="{{item.dieTooltip}}">
				<i class="fa-solid fa-dice-d20"></i>
			</a>
		</div>
	</div>
</li>
