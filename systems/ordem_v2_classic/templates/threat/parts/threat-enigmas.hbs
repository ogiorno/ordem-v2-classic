<section class="threat-notes sb sb-notes flexcol">
	{{#if isCreature}}
		<div class="sb-block">
			<span class="sb-label"><i class="fa-solid fa-puzzle-piece"></i> {{localize "op.threat.enigma"}}</span>
			{{#if editable}}
				<prose-mirror name="system.details.fearRiddle" data-document-uuid="{{actor.uuid}}" value="{{system.details.fearRiddle}}" collaborate="true" toggled="true">
					{{{enrichedFearRiddle}}}
				</prose-mirror>
			{{else}}
				<div class="locked-content">{{{enrichedFearRiddle}}}</div>
			{{/if}}
		</div>
	{{/if}}
	<div class="sb-block">
		<span class="sb-label"><i class="fa-solid fa-book-open"></i> {{localize "op.threat.description"}}</span>
		{{#if editable}}
			<prose-mirror name="system.details.description" data-document-uuid="{{actor.uuid}}" value="{{system.details.description}}" collaborate="true" toggled="true">
				{{{enrichedDescription}}}
			</prose-mirror>
		{{else}}
			<div class="locked-content">{{{enrichedDescription}}}</div>
		{{/if}}
	</div>
</section>
