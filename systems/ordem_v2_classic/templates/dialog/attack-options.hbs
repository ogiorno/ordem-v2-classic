<form class="op-attack-form">
	<p class="op-ad-sub">{{skillLine}}</p>

	<section class="op-ad-block op-ad-weapon" data-weapon-block>
		<h4>{{localize "op.attackDialog.weapon"}}</h4>
		{{#if weapon.chips.length}}<div class="op-ad-chips">{{#each weapon.chips}}<span class="op-ad-weapon-tag">{{this}}</span>{{/each}}</div>{{/if}}
		{{#if weapon.showModes}}
		<div class="op-ad-modes">
			{{#each weapon.modes}}<label class="op-ad-mode"><input type="radio" name="weaponMode" value="{{id}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
		</div>
		{{/if}}
		{{#if weapon.attrChoice}}
		<label class="op-ad-field" data-attr-row>{{localize "op.attackDialog.attackWith"}}
			<select name="weaponAttr">{{#each weapon.attrChoice}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
		</label>
		{{/if}}
		{{#if weapon.grips}}
		<label class="op-ad-field">{{localize "op.attackDialog.grip"}}
			<select name="weaponGrip">{{#each weapon.grips}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select>
		</label>
		{{/if}}
		{{#each weapon.ruleChoices}}
		<label class="op-ad-rule-choice" data-rule-choice="{{id}}"><input type="checkbox" name="{{id}}" {{#if checked}}checked{{/if}}> {{label}}</label>
		{{/each}}
		<div class="op-ad-applied" data-rules {{#unless weapon.rules.length}}hidden{{/unless}}>
			{{#each weapon.rules}}<div class="op-ad-applied-row is-{{state}}">{{text}}</div>{{/each}}
		</div>
		<p class="op-ad-range" data-range-note hidden></p>
	</section>

	{{#if passive.length}}
	<section class="op-ad-block">
		<h4>{{localize "op.attackDialog.applied"}}</h4>
		<div class="op-ad-applied">
			{{#each passive}}<div class="op-ad-applied-row {{#if bad}}is-bad{{else}}is-good{{/if}}"><span><strong>{{label}}</strong> {{value}}{{#if source}} <em>({{source}})</em>{{/if}}</span>{{#if description}}<small>{{description}}</small>{{/if}}</div>{{/each}}
			{{#each autos}}<div class="op-ad-applied-row is-good"><span><strong>{{label}}</strong>{{#if summary}} {{summary}}{{/if}}{{#if source}} <em>({{source}})</em>{{/if}}</span>{{#if description}}<small>{{description}}</small>{{/if}}</div>{{/each}}
		</div>
	</section>
	{{else if autos.length}}
	<section class="op-ad-block">
		<h4>{{localize "op.attackDialog.applied"}}</h4>
		<div class="op-ad-applied">
			{{#each autos}}<div class="op-ad-applied-row is-good"><span><strong>{{label}}</strong>{{#if summary}} {{summary}}{{/if}}{{#if source}} <em>({{source}})</em>{{/if}}</span>{{#if description}}<small>{{description}}</small>{{/if}}</div>{{/each}}
		</div>
	</section>
	{{/if}}

	<section class="op-ad-block op-ad-conditions" data-condition-block {{#unless conditions.length}}hidden{{/unless}}>
		<h4>{{localize "op.attackDialog.conditions"}}</h4>
		<div class="op-ad-condition-list" data-condition-list>
			{{#each conditions}}
			<div class="op-ad-condition">
				<span class="op-ad-condition-label">{{name}}{{#if detail}} · {{detail}}{{/if}}{{#if description}}<small>{{description}}</small>{{/if}}</span>
				{{#if ../canRemoveConditions}}<button type="button" data-action="remove-condition" data-effect-id="{{id}}">{{localize "op.attackDialog.removeCondition"}}</button>{{/if}}
			</div>
			{{/each}}
		</div>
	</section>

	{{#if hasChoices}}
	<section class="op-ad-block">
		<h4>{{localize "op.attackDialog.options"}}</h4>
		<div class="op-ad-list">
			{{#each pools}}
			<div class="op-ad-row op-ad-pool" data-pool="{{id}}" data-max="{{max}}" data-ability-max="{{abilityMax}}" data-limit="{{limit}}" data-per-turn="{{perTurn}}">
				<div class="op-ad-name"><strong>{{label}}</strong>{{#if summary}}<small>{{summary}} · {{localize "op.attackDialog.upTo" max=abilityMax}}</small>{{/if}}{{#if source}}<small>{{source}}</small>{{/if}}</div>
				<label class="op-ad-step">{{localize "op.attackDialog.inAttack"}} <select name="pool.{{id}}.attack">{{#each choices}}<option value="{{stacks}}">{{label}}</option>{{/each}}</select></label>
				<label class="op-ad-step">{{localize "op.attackDialog.inDamage"}} <select name="pool.{{id}}.damage">{{#each choices}}<option value="{{stacks}}">{{label}}</option>{{/each}}</select></label>
				<span class="op-ad-cost" data-pool-cost>{{onUse.cost}}{{#if onUse.stepCost}}+{{onUse.stepCost}}{{/if}} {{../resource}}</span>
				<p class="op-ad-pool-flag" data-pool-flag hidden></p>
			</div>
			{{/each}}
			{{#each stackables}}
			<div class="op-ad-row">
				<div class="op-ad-name"><strong>{{label}}</strong>{{#if summary}}<small>{{summary}}</small>{{/if}}{{#if source}}<small>{{source}}</small>{{/if}}</div>
				<label class="op-ad-step"><input type="number" name="opt.{{id}}" min="0" max="{{max}}" step="1" value="0"></label>
				<span class="op-ad-cost">{{onUse.cost}} {{../resource}}</span>
			</div>
			{{/each}}
			{{#each toggles}}
			<label class="op-ad-row">
				<span class="op-ad-check"><input type="checkbox" name="opt.{{id}}" value="1"></span>
				<span class="op-ad-name"><strong>{{label}}</strong>{{#if summary}}<small>{{summary}}</small>{{/if}}{{#if source}}<small>{{source}}</small>{{/if}}</span>
				<span class="op-ad-cost">{{#if onUse.cost}}{{onUse.cost}} {{../resource}}{{else}}—{{/if}}</span>
			</label>
			{{/each}}
		</div>
	</section>
	{{/if}}

	<section class="op-ad-free">
		<label>{{localize "op.attackDialog.freeAttack"}}<input type="text" name="freeAttack" placeholder="+2 · −1d"></label>
		<label>{{localize "op.attackDialog.freeDamage"}}<input type="text" name="freeDamage" placeholder="+1d6"></label>
	</section>

	<footer class="op-ad-foot">
		<span>{{localize "op.attackDialog.total"}} <strong data-total>0 {{resource}}</strong> · {{localize "op.attackDialog.left"}} <span data-left>{{balance}}</span> {{resource}}</span>
		<span class="op-ad-hint">{{localize "op.attackDialog.shiftHint"}}</span>
	</footer>
</form>
