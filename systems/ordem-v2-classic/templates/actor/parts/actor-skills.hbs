<section class="tab flexcol {{tab.cssClass}}" data-tab="skills" data-group="primary">
	{{#if training}}
		<div class="op-train-counter {{training.cls}}">
			<a class="op-train-main" data-action="openTrainingDetail" title="Quantas perícias posso ter?">
				<span><b>Perícias treinadas</b> {{training.train.used}} / {{training.train.allowed}}</span>
				{{#if training.showRaise}}<span><b>Aumentos de grau</b> {{training.raise.used}} / {{training.raise.allowed}}</span>{{/if}}
				<span><b>Pontos</b> {{training.points.used}} / {{training.points.allowed}}</span>
				{{#if training.over}}<span class="op-train-over">acima do limite</span>{{/if}}
			</a>
			{{#if training.hasPending}}<button type="button" class="op-train-choose" data-action="chooseTraining">Escolher ({{training.pending}})</button>{{else if training.freeRaise}}<button type="button" class="op-train-choose" data-action="chooseTraining">Subir de grau ({{training.freeRaise}})</button>{{/if}}
		</div>
	{{/if}}
	<p class="skills-legend">{{localize "op.skillCols.legend"}}</p>
	<div class="skills-details">
		<div class="skills-content">
			{{#each system.skills as |skill key|}}
				<div class="skill flexrow flex-group-center">

					{{! NOME DA PERÍCIA }}
					{{#if skill.conditions.open}}
						<input
							type="text"
							name="system.skills.{{key}}.name"
							value="{{skill.name}}"
							class="resource-label flexlarge align-center"
							data-type="String"
							placeholder="{{localize 'op.skill.freeSkill'}}"
						/>
						<i
							class="fas fa-dice {{key}} rollable rollFreeSkill compendium-event-contextmenu"
							data-action="onRollSkillCheck"
							data-roll="{{skill.formula}}"
							data-label="{{skill.label}}"
							data-key="{{key}}"
						></i>
					{{else}}
						<label
							for="system.skills.{{key}}.value"
							data-action="onRollSkillCheck"
							class="resource-label rollable flexlarge align-left skill-name compendium-event-contextmenu"
							data-label="{{skill.label}}"
							data-key="{{key}}"
							data-rollType="skill"
						>{{skill.label}}</label>
					{{/if}}

					{{! ATRIBUTO }}
					<label class="flex0 p-side-10">
						<strong>{{toUpperCase (localize (concat "op." (lookup skill.attr 0) "Abv"))}}</strong>
					</label>

					{{! TREINO }}
					<select name="system.skills.{{key}}.degree.label" data-dtype="String">
						{{selectOptions @root.optionDegree selected=skill.degree.label localize=true}}
					</select>
					{{#with (lookup @root.trainingSkills key) as |ti|}}<i class="fas {{ti.icon}} op-train-badge" title="{{ti.title}}"></i>{{/with}}

					{{! NOVO: VALOR TOTAL (Calculado no actor-sheet.mjs) }}
					<div class="flex0" style="margin: 0 5px; display: flex; justify-content: center;">
						<input
							type="text"
							value="{{numberFormat (lookup @root.skillTotals key) decimals=0 sign=true}}"
							readonly
							style="width: 40px; text-align: center; border: none; font-weight: bold; background: rgba(0,0,0,0.05);"
							title="{{localize 'op.totalSkillTooltip'}}"
						/>
					</div>

					{{! BÔNUS EDITÁVEL }}
					<input
						type="text"
						name="system.skills.{{key}}.mod"
						value="{{skill.mod}}"
						data-dtype="Number"
						class="modifier" title="{{localize 'op.skillCols.bonusTip'}}"
						placeholder="0"
					/>

				</div>
			{{/each}}
		</div>
	</div>
</section>