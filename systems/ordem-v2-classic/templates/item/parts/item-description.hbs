<section class="tab description {{tab.cssClass}}" data-group="primary" data-tab="description">
	<div class="content-item description-container {{ternary isAnyDescriptionEditing '' 'scrollable'}}">

		{{#if originGrants}}
			<section class="op-origin-grants op-shadow" aria-label="O que esta origem concede">
				<h3 class="op-origin-grants-title"><i class="fa-solid fa-gift" aria-hidden="true"></i> O que esta origem concede</h3>
				<ul>
					{{#each originGrants.rows}}
						<li class="op-origin-grant is-{{key}}">
							<span class="op-origin-grant-head"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{title}}</span>
							{{#if items.length}}
								<span class="op-origin-grant-items">{{#each items}}<span class="op-origin-grant-item {{#if choice}}is-choice{{/if}}">{{{html}}}</span>{{/each}}</span>
							{{/if}}
							{{#if note}}<span class="op-origin-grant-note">{{note}}</span>{{/if}}
						</li>
					{{/each}}
				</ul>
			</section>
		{{/if}}

		<details
			class="description-box op-shadow {{ternary editingDescription 'fullscreen-editor' ''}}"
			{{ternary editingDescription "open" ""}}
		>
			<summary>
				<div class="summary-title flex-row gap-1 align-items-center">
					<i class="fas fa-info-circle"></i>
					<span>Descrição do Item</span>
				</div>

				{{#if editable}}
					<a class="editor-edit description" data-action="editDescription" title="Expandir e Editar">
						<i class="fas fa-edit"></i>
					</a>
				{{/if}}
			</summary>

			<div class="description-content-inner">
				<div class="content-wrapper">
					{{#if editingDescription}}
						<div class="fullscreen-editor-header">
							<img src="{{item.img}}" alt="{{item.name}}" />
							<h2>{{item.name}} <span>- Editando Descrição</span></h2>
						</div>

						<prose-mirror
							name="system.description"
							data-document-uuid="{{item.uuid}}"
							value="{{system.description}}"
							collaborate="true"
						>
							{{{enrichedDescription}}}
						</prose-mirror>
					{{else}}
						<div class="description-content">{{{enrichedDescription}}}</div>
					{{/if}}
				</div>
			</div>
		</details>

		<details
			class="description-box chat-description op-shadow {{ternary editingChatDescription 'fullscreen-editor' ''}}"
			{{ternary editingChatDescription "open" ""}}
		>
			<summary>
				<div class="summary-title flex-row gap-1 align-items-center">
					<i class="fas fa-comment-dots"></i>
					<span>Descrição para Chat</span>
				</div>

				{{#if editable}}
					<a class="editor-edit chat-description" data-action="editChatDescription" title="Expandir e Editar">
						<i class="fas fa-edit"></i>
					</a>
				{{/if}}

				<p class="notes">Se preenchida, esta descrição será usada para exibição no chat.</p>
			</summary>

			<div class="description-content-inner">
				<div class="content-wrapper">
					{{#if editingChatDescription}}
						<div class="fullscreen-editor-header">
							<img src="{{item.img}}" alt="{{item.name}}" />
							<h2>{{item.name}} <span>- Descrição de Chat</span></h2>
						</div>

						<prose-mirror
							name="system.chatDescription"
							data-document-uuid="{{item.uuid}}"
							value="{{system.chatDescription}}"
							collaborate="true"
						>
							{{{enrichedChatDescription}}}
						</prose-mirror>
					{{else}}
						<div class="description-content">{{{enrichedChatDescription}}}</div>
					{{/if}}
				</div>
			</div>
		</details>

	</div>
</section>